# SQLite default preserves backend/file_processing.db. Override for PostgreSQL:
# DATABASE_URL=postgresql+psycopg://intake:password@localhost:5432/intake
# DATA_DIR=/absolute/path/to/data
MAX_UPLOAD_BYTES=10485760
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional AI: core features work without these credentials.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://models.inference.ai.azure.com
OPENAI_MODEL=gpt-5-mini

# Local Python API/dispatcher/worker use localhost; Compose uses redis:6379 internally.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_QUEUE=csv-processing
JOB_TIME_LIMIT_SECONDS=120
JOB_LEASE_SECONDS=150
JOB_MAX_ATTEMPTS=3
DISPATCH_INTERVAL_SECONDS=2
JOB_REDISPATCH_SECONDS=30
JOB_QUEUE_TIMEOUT_SECONDS=600
PUBLISH_MAX_FAILURES=8
